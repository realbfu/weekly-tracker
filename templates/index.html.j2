<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>每週投資追蹤</title>
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js" charset="utf-8"></script>
<style>
  :root {
    --bg: #f6f7f9; --card: #ffffff; --text: #1c2430; --muted: #667085; --border: #e3e6ec; --grid: #e6e9ef;
    --hot-bg: #f4cccc; --hot-fg: #7a1f1f;
    --cold-bg: #cfe2f3; --cold-fg: #1b4468;
    --good-bg: #d9ead3; --good-fg: #23531a;
    --warn-bg: #fff2cc; --warn-fg: #6b4e00;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0f1419; --card: #182028; --text: #e6e9ee; --muted: #9aa4b2; --border: #2a3441; --grid: #2a3441;
      --hot-bg: #5a2727; --hot-fg: #ffd0d0;
      --cold-bg: #23445f; --cold-fg: #cfe6fb;
      --good-bg: #2a4a26; --good-fg: #d5f0cf;
      --warn-bg: #5a4a17; --warn-fg: #ffeaa8;
    }
  }
  :root[data-theme="dark"] {
    --bg: #0f1419; --card: #182028; --text: #e6e9ee; --muted: #9aa4b2; --border: #2a3441; --grid: #2a3441;
    --hot-bg: #5a2727; --hot-fg: #ffd0d0;
    --cold-bg: #23445f; --cold-fg: #cfe6fb;
    --good-bg: #2a4a26; --good-fg: #d5f0cf;
    --warn-bg: #5a4a17; --warn-fg: #ffeaa8;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.6 -apple-system, BlinkMacSystemFont, "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 48px; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 18px; margin: 36px 0 12px; }
  .sub { color: var(--muted); margin: 0 0 16px; }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 16px; margin-bottom: 16px; }
  .card h3 { font-size: 15px; margin: 0 0 12px; }
  .meta { color: var(--muted); font-size: 13px; font-weight: normal; }
  .meta a { color: inherit; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 8px; }
  .tile { border: 1px solid var(--border); border-radius: 10px; padding: 12px; }
  .tile .label { color: var(--muted); font-size: 13px; }
  .tile .value { font-size: 28px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .tile .small { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .badge { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 12px; }
  .hot { background: var(--hot-bg); color: var(--hot-fg); }
  .cold { background: var(--cold-bg); color: var(--cold-fg); }
  .good { background: var(--good-bg); color: var(--good-fg); }
  .warn { background: var(--warn-bg); color: var(--warn-fg); }
  .banner { border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; font-size: 14px; }
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  caption { text-align: left; font-weight: 600; padding-bottom: 8px; }
  th, td { padding: 8px 10px; text-align: right; border-bottom: 1px solid var(--border); white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; }
  th { color: var(--muted); font-weight: 500; font-size: 13px; }
  td.na { color: var(--muted); }
  .charts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .chart { height: 340px; }
  .chart.tall { height: 320px; }
  footer { color: var(--muted); font-size: 12px; margin-top: 32px; }
  @media (max-width: 760px) { .charts { grid-template-columns: 1fr; } .tile .value { font-size: 24px; } }
</style>
</head>
<body>
<main>
  <h1>每週投資追蹤</h1>
  <p class="sub">更新於 {{ updated_at }}（台北時間）　市場寬度、景氣對策信號、BIAS／PE、台積電營運、價格走勢</p>

  {% for msg in fatal %}<div class="banner hot">⚠ {{ msg }}</div>{% endfor %}
  {% for msg in warnings %}<div class="banner warn">注意：{{ msg }}</div>{% endfor %}

  <h2>市場寬度</h2>
  {% for m in breadth %}
  <section class="card" aria-label="{{ m.title }}">
    <h3>{{ m.title }} <span class="meta">資料日 {{ m.summary.date }}　有效樣本 {{ m.summary.valid }} 檔</span></h3>
    <div class="tiles">
      {% for n, v in m.summary['values'].items() %}
      <div class="tile">
        <div class="label">站上 {{ n }} 日均線</div>
        <div class="value">{{ v.pct | fmt(1) }}%</div>
        <span class="badge {{ v.zone | zone_class }}">{{ v.zone }}</span>
        <div class="small">{{ v.above }} / {{ m.summary.valid }} 檔　較上週 {{ v.delta | fmt(1, true) }} pt</div>
      </div>
      {% endfor %}
    </div>
    {% if m.summary.long_term %}<p><span class="badge {{ 'hot' if '頭部' in m.summary.long_term else 'cold' }}">{{ m.summary.long_term }}</span></p>{% endif %}
    <div class="chart tall" id="{{ m.id }}"></div>
    {% if m.note %}<p class="meta">{{ m.note }}</p>{% endif %}
  </section>
  {% endfor %}

  <h2>景氣對策信號</h2>
  <section class="card">
    {% if business_cycle %}
    <div class="tiles">
      <div class="tile">
        <div class="label">綜合判斷分數 <span class="meta">資料月份 {{ business_cycle.date }}</span></div>
        <div class="value">{{ business_cycle.score | fmt(0) }}</div>
        <span class="badge {{ business_cycle.light | zone_class }}">{{ business_cycle.light }}燈</span>
      </div>
    </div>
    {% if business_cycle_chart %}<div class="chart tall" id="{{ business_cycle_chart.id }}"></div>{% endif %}
    <p class="meta">來源：國家發展委員會（政府資料開放平臺）。分數 9–45，燈號對應區間：藍 ≤16、黃藍 17–22、綠 23–31、黃紅 32–37、紅 ≥38。</p>
    <p class="meta">原始資料：<a href="https://index.ndc.gov.tw/n/zh_tw/data/eco" target="_blank" rel="noopener">景氣指標查詢系統</a></p>
    {% else %}
    <p class="na">資料取得失敗</p>
    {% endif %}
  </section>

  <h2>BIAS／PE</h2>
  {% for t in bias_tables %}
  <section class="card scroll">
    <table>
      <caption>{{ t.title }}</caption>
      <thead><tr>
        <th scope="col">標的</th><th scope="col">資料日</th><th scope="col">收盤</th>
        {% for n in t.periods %}<th scope="col">{{ n }}{{ t.unit }} <span class="meta">±{{ t.thresholds[n] | fmt(0) }}%</span></th>{% endfor %}
        <th scope="col">Trailing PE</th><th scope="col">Forward PE</th><th scope="col">備註</th>
      </tr></thead>
      <tbody>
      {% for r in t.rows %}
        <tr>
          <th scope="row" style="color:var(--text);font-weight:500">{{ r.name }}</th>
          {% if r.data %}
          <td>{{ r.data.date }}</td><td>{{ r.data.close | fmt(2) }}</td>
          {% for n in t.periods %}
            {% set a = r.data.alert[n] %}
            <td class="{{ a or '' }}{{ ' na' if r.data.bias[n] is none else '' }}">{{ r.data.bias[n] | fmt(2, true) }}%</td>
          {% endfor %}
          {% else %}
          <td class="na" colspan="{{ 2 + t.periods | length }}">BIAS 取得失敗</td>
          {% endif %}
          <td class="{{ 'na' if r.pe.trailing is none else '' }}">{{ r.pe.trailing | fmt(2) }}</td>
          <td class="{{ 'na' if r.pe.forward is none else '' }}">{{ r.pe.forward | fmt(2) }}</td>
          <td class="na" style="text-align:left">{{ r.pe.note }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endfor %}
  <p class="meta"><span class="badge hot">紅</span> 正乖離超過門檻　<span class="badge cold">藍</span> 負乖離超過門檻　BIAS = (收盤 − 均線) ÷ 均線　PE 資料來源：Yahoo Finance</p>

  <h2>台積電營運（2330）</h2>
  <section class="card scroll">
    <table>
      <caption>月營收</caption>
      <thead><tr>
        <th scope="col">月份</th><th scope="col">營收（千元）</th><th scope="col">MoM%</th><th scope="col">YoY%</th>
      </tr></thead>
      <tbody>
      {% for r in tsmc_monthly %}
        <tr>
          <th scope="row" style="color:var(--text);font-weight:500">{{ r.date }}</th>
          <td>{{ r.revenue | fmt(0) }}</td>
          <td class="{{ 'na' if r.mom_pct is none else '' }}">{{ r.mom_pct | fmt(2, true) }}%</td>
          <td class="{{ 'na' if r.yoy_pct is none else '' }}">{{ r.yoy_pct | fmt(2, true) }}%</td>
        </tr>
      {% else %}
        <tr><td class="na" colspan="4">資料取得失敗</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  <section class="card scroll">
    <table>
      <caption>季度損益（單季）</caption>
      <thead><tr>
        <th scope="col">季度</th><th scope="col">營收（千元）</th><th scope="col">毛利（千元）</th><th scope="col">毛利率</th>
        <th scope="col">淨利（千元）</th><th scope="col">淨利率</th><th scope="col">QoQ%</th><th scope="col">YoY%</th>
      </tr></thead>
      <tbody>
      {% for r in tsmc_quarterly %}
        <tr>
          <th scope="row" style="color:var(--text);font-weight:500">{{ r.year }}Q{{ r.quarter }}</th>
          <td>{{ r.revenue | fmt(0) }}</td>
          <td>{{ r.gross_profit | fmt(0) }}</td>
          <td>{{ r.gross_margin_pct | fmt(1) }}%</td>
          <td>{{ r.net_profit | fmt(0) }}</td>
          <td>{{ r.net_margin_pct | fmt(1) }}%</td>
          <td class="{{ 'na' if r.qoq_pct is none else '' }}">{{ r.qoq_pct | fmt(2, true) }}%</td>
          <td class="{{ 'na' if r.yoy_pct is none else '' }}">{{ r.yoy_pct | fmt(2, true) }}%</td>
        </tr>
      {% else %}
        <tr><td class="na" colspan="8">資料取得失敗</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  <p class="meta">資料來源：公開資訊觀測站（MOPS）。月營收僅揭露營收數字，毛利／淨利僅於季報公布；季度損益為單季數字（已還原累計數）。</p>

  <h2>價格走勢</h2>
  <div class="charts">
    {% for c in price_charts %}<div class="card"><div class="chart" id="{{ c.id }}"></div></div>{% endfor %}
  </div>

  <footer>資料來源：Yahoo Finance、臺灣證券交易所（TWSE）。僅供個人追蹤參考，不構成投資建議。</footer>
</main>

<script>
(function () {
  var figs = [
    {% for m in breadth %}{ id: "{{ m.id }}", fig: {{ m.chart | safe }} },
    {% endfor %}
    {% if business_cycle_chart %}{ id: "{{ business_cycle_chart.id }}", fig: {{ business_cycle_chart.json | safe }} },
    {% endif %}
    {% for c in price_charts %}{ id: "{{ c.id }}", fig: {{ c.json | safe }} },
    {% endfor %}
  ];
  function css(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
  function themeUpdate() {
    return {
      "font.color": css("--text"),
      "xaxis.gridcolor": css("--grid"), "yaxis.gridcolor": css("--grid"),
      "xaxis.linecolor": css("--border"), "yaxis.linecolor": css("--border"),
      "xaxis.rangeselector.bgcolor": css("--card"),
      "xaxis.rangeselector.activecolor": css("--border"),
      "xaxis.rangeselector.font.color": css("--text")
    };
  }
  figs.forEach(function (f) {
    Plotly.newPlot(f.id, f.fig.data, f.fig.layout, {
      responsive: true, displaylogo: false,
      modeBarButtonsToRemove: ["zoomIn2d", "zoomOut2d", "lasso2d", "select2d", "autoScale2d"]
    }).then(function () {
      Plotly.relayout(f.id, themeUpdate());
    });
  });
  var mq = window.matchMedia("(prefers-color-scheme: dark)");
  var repaint = function () { figs.forEach(function (f) { Plotly.relayout(f.id, themeUpdate()); }); };
  if (mq.addEventListener) mq.addEventListener("change", repaint);
})();
</script>
</body>
</html>
